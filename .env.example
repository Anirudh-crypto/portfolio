# Copy to .env.local and fill in from the Firebase console:
# Project settings → General → Your apps → SDK setup and configuration.
#
# These are NEXT_PUBLIC_* on purpose — Firebase web config is not secret. What
# protects your data is firestore.rules, not the secrecy of these values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Firestore database is a NAMED one, not "(default)".
NEXT_PUBLIC_FIREBASE_DATABASE_ID=portfolio-admin

# The single Google account allowed to use /admin. Must match the email in
# firestore.rules, which is what actually enforces it.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# Absolute production URL, used for canonical links, OG tags and the sitemap.
# Falls back to the Vercel project URL, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Forwards contact-form submissions to NEXT_PUBLIC_ADMIN_EMAIL via Resend.
# NOT public — this is a server-only secret.
# Optional: without it the form still works and still archives to Firestore,
# it just sends no email notification.
RESEND_API_KEY=
