rules_version = '2';

// Rules for the named database `portfolio-admin`.
// Deploy with: firebase deploy --only firestore:rules
//
// The /admin page's sign-in check is cosmetic — it only controls what the UI
// renders. These rules are the actual boundary: without them, anyone can call
// the Firestore REST API directly and write to the collections below.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ani.josh01@gmail.com';
    }

    /** Optional string field: absent is fine, present must be a capped string. */
    function optionalText(data, field, maxSize) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function isValidProject(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.details is list && data.details.size() <= 20
        && data.tech is list && data.tech.size() <= 30
        // Episode framing.
        && optionalText(data, 'episodeTitle', 200)
        && optionalText(data, 'guestStarring', 100)
        && optionalText(data, 'runtime', 100)
        // Case-study beats.
        && optionalText(data, 'coldOpen', 5000)
        && optionalText(data, 'plot', 5000)
        && optionalText(data, 'twist', 5000)
        && optionalText(data, 'finale', 5000)
        && (!('metrics' in data) || (data.metrics is list && data.metrics.size() <= 10));
    }

    // Projects are public content: anyone may read, only the owner may write.
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidProject(request.resource.data);
      allow delete: if isOwner();
    }

    // Contact-form submissions: anyone may create one (the form is public),
    // nobody but the owner may read them back. The size caps and the exact
    // field-set check are what keep this from being an open write endpoint.
    match /messages/{messageId} {
      allow read, update, delete: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
